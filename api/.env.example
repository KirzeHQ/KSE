# KSE API environment example
# Copy this file to `.env` in the api/ folder and fill in values.

# Server
BIND_ADDR=127.0.0.1:8080

# SQLite DB file used for metadata
DB_FILE=data/db.sqlite

# Additional auth DBs (created automatically)
# api_keys.db and scrapers.db are created under the `data/` directory by the API.
# You normally don't need to set these, but they're shown here for reference.
API_KEYS_DB=data/api_keys.db
SCRAPERS_DB=data/scrapers.db

# Local storage directories (kept if S3/R2 not configured)
HOT_DIR=hot
COLD_DIR=cold

# S3-compatible storage, set S3_BUCKET to enable upload
S3_BUCKET=
S3_ENDPOINT=
DISABLE_S3=true

# Credentials
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=auto

# Optional: control SDK behaviour/logging
RUST_LOG=info

# Public suffix list refresh interval (hours)
PSL_REFRESH_HOURS=24

# Archive worker interval (minutes) — how often the background uploader runs
ARCHIVE_INTERVAL_MIN=30

# AWS-compatible env var fallbacks (the API will also read these)
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION can be set instead of ACCESS_KEY_ID/SECRET_ACCESS_KEY/REGION
# Example:
# AWS_ACCESS_KEY_ID=yourkey
# AWS_SECRET_ACCESS_KEY=yoursecret
# AWS_REGION=us-east-1