# Example env for indexer
API_BASE=http://kse.kirze.de/api/v1
API_KEY=your_api_key_here
POLL_INTERVAL_MS=5000
FETCH_TIMEOUT_MS=15000
CONCURRENCY=4
# Indexer env - copy this to .env and fill secrets (do NOT commit real secrets)
# The API_BASE should point to the API root including the /api/v1 path.
# Poll interval between job claims (ms)
# Fetch timeout for HTTP requests (ms)
# Number of concurrent worker fetchers
# NOTE: Batch size is fixed at 10000 links per submission
