# Copy this file to .env and fill in the values

# Database Stuff
DB_USERNAME=user
DB_PASSWORD=password
DB_HOST=db
DB_NAME=kse_dev
DB_PORT=5432
# Full database URL
DATABASE_URL=postgresql://user:password@db:5432/kse_dev

# Rails Environment
RAILS_ENV=development

# Generate with `rails secret`
SECRET_KEY_BASE=
RAILS_PORT=3000

# Watchtower (we dont use)
DOCKER_API_VERSION=1.40
WATCHTOWER_CONTAINER_NAME=kse-watchtower
WATCHTOWER_ENABLED=false

# Set to your frontend site where users will be redirected after OAuth
FRONTEND_URL=http://localhost:3000

# GitHub OAuth (create a GitHub OAuth App and fill these values)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: override the auto-detected redirect URI
# GitHub OAuth callback URL (set this as the "Authorization callback URL" in your GitHub OAuth App):
#   <your-backend-base>/api/v1/acc/oauth/github/callback
# Example for local development when Rails runs on port 3000:
#   http://localhost:3000/api/v1/acc/oauth/github/callback
# The Rails app reads these via `ENV["GITHUB_CLIENT_ID"]`, `ENV["GITHUB_CLIENT_SECRET"]`, and `ENV["GITHUB_REDIRECT_URI"]` (see `app/controllers/api/v1/oauth_controller.rb`).
GITHUB_REDIRECT_URI=

# Mailer / SMTP settings
# For local dev you can use Gmail SMTP or a dev SMTP service (Mailtrap, MailHog, etc.)
# SEND_FROM - the email address used as the From address and as the SMTP username (required)
SEND_FROM=example@gmail.com
# SEND_FROM_NAME - optional human-readable sender name (e.g., Support)
SEND_FROM_NAME=name-here
# MAIL_PASSWORD - SMTP password or API key (required)
MAIL_PASSWORD=
# SMTP_ADDRESS - SMTP host (default: smtp.gmail.com)
SMTP_ADDRESS=smtp.gmail.com
# SMTP_PORT - SMTP port (587 for STARTTLS, 465 for implicit SSL/SMTPS)
SMTP_PORT=587
# SMTP_USER - optional SMTP username; if unset, SEND_FROM is used
# SMTP_USER=
# SMTP_DOMAIN - HELO/EHLO domain presented to the SMTP server; set this to your sending domain (the domain part of SEND_FROM, e.g. kirze.de), not a URL; for local dev use localhost
SMTP_DOMAIN=localhost
# SMTP_AUTHENTICATION - SMTP auth method (plain/login); default: plain
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS - set to true/false to explicitly enable STARTTLS (defaults to true)
# SMTP_ENABLE_STARTTLS=true
# SMTP_SSL - set to true to force implicit SSL (SMTPS, port 465)
# SMTP_SSL=false
# SMTP_OPENSSL_VERIFY_MODE - e.g. none to relax TLS cert verification (use with caution)
# SMTP_OPENSSL_VERIFY_MODE=
# MAIL_DELIVERY_METHOD - delivery method (smtp or test); use test for local dev
# MAIL_DELIVERY_METHOD=smtp